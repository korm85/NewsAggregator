<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.gavan.capture.ui.OverlayView
        android:id="@+id/overlay_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/countdown_numeral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="@color/onSurface"
        android:textSize="120sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:visibility="gone" />

    <TextView
        android:id="@+id/prompt_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:background="#B0000000"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/onSurface"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageButton
            android:id="@+id/gallery_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#60000000"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Gallery" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/torch_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="#60000000"
            android:src="@android:drawable/ic_lock_idle_low_battery"
            android:contentDescription="Torch" />

        <ImageButton
            android:id="@+id/switch_camera_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="#60000000"
            android:src="@android:drawable/ic_menu_rotate"
            android:contentDescription="Switch camera" />

        <ImageButton
            android:id="@+id/debug_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#60000000"
            android:src="@android:drawable/ic_menu_manage"
            android:contentDescription="Debug panel" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#60000000"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/mode_auto_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto" />

            <Button
                android:id="@+id/mode_manual_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manual" />
        </LinearLayout>

        <Button
            android:id="@+id/shutter_btn"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@color/onSurface"
            android:text="" />

        <TextView
            android:id="@+id/session_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/onSurface"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/debug_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#D0000000"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance min"
                android:textColor="@color/onSurface" />
            <SeekBar
                android:id="@+id/distance_min_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distance max"
                android:textColor="@color/onSurface" />
            <SeekBar
                android:id="@+id/distance_max_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Countdown duration (ms)"
                android:textColor="@color/onSurface" />
            <SeekBar
                android:id="@+id/countdown_duration_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="5000" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Preview orientation wrong? Rotate it manually:"
                android:textColor="@color/onSurface" />
            <Button
                android:id="@+id/rotate_preview_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rotate 90°" />

            <TextView
                android:id="@+id/debug_readout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/accent"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
